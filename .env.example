# Site URL for metadataBase, Open Graph, Sitemap & canonical links
# Optional: falls back to VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL, or http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Anthropic API Key for server-side "Ask My AI" route (/api/chat)
# Get an API key at https://console.anthropic.com/
# Stored on server only; NEVER prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=

# Optional: Claude model name (defaults to claude-haiku-5-5)
CHAT_MODEL=claude-haiku-5-5
